# Copy to .env and adjust.
# For production: set your domain and use https in CORS/CSRF origins.

POSTGRES_PASSWORD=vuvoz_secret
DJANGO_SECRET_KEY=your-secret-key

# Comma-separated. Production: your domain(s), e.g. vuvoz.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Production: use https://your-domain.com (comma-separated if multiple)
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
