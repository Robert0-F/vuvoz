# =============================================================================
# Vuvoz — шаблон секретов и настроек окружения
# =============================================================================
# 1. Скопируйте:  cp .env.example .env
# 2. Заполните все значения CHANGE_ME (реальные пароли только в .env)
# 3. На сервере:  chmod 600 .env
#
# Файл .env в git не коммитится. В репозитории только этот пример.
# Пароли пользователей сайта (admin, school01…) здесь НЕ хранятся — только в БД.
# =============================================================================

# --- Django (обязательно) ---
# Сгенерировать: openssl rand -base64 50
DJANGO_SECRET_KEY=CHANGE_ME

# Production: False. Local dev без Docker: True
DJANGO_DEBUG=False

# --- PostgreSQL (Gunicorn + Nginx: обязательно DATABASE_URL) ---
# Формат: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Пример для сервера: postgres://vuvoz_user:CHANGE_ME@localhost:5432/vuvoz_db
DATABASE_URL=postgres://vuvoz_user:CHANGE_ME@localhost:5432/vuvoz_db

# Отдельные поля (для документации / pg_dump; Docker Compose тоже читает их)
# Gunicorn: vuvoz_user + vuvoz_db. Docker: часто POSTGRES_USER=vuvoz и POSTGRES_DB=vuvoz
POSTGRES_USER=vuvoz_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=vuvoz_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Почта (SMTP) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@zeleniyschet.online
SERVER_EMAIL=noreply@zeleniyschet.online

# Docker dev: Mailpit — раскомментируйте при docker compose
# EMAIL_HOST=mailpit
# EMAIL_PORT=1025
# EMAIL_USE_TLS=False

# --- Домен и безопасность (production) ---
# Через запятую, без пробелов. Подставьте IP и домен.
ALLOWED_HOSTS=zeleniyschet.online,www.zeleniyschet.online,85.239.40.127,localhost,127.0.0.1

# http:// для теста по IP; https:// после Certbot
CORS_ALLOWED_ORIGINS=https://zeleniyschet.online,https://www.zeleniyschet.online
CSRF_TRUSTED_ORIGINS=https://zeleniyschet.online,https://www.zeleniyschet.online

# Публичный URL сайта (для ссылок в письмах и media). Пусто = same origin.
BASE_URL=https://zeleniyschet.online

# False до настройки HTTPS; True после Certbot
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# --- JWT (опционально, иначе значения по умолчанию в settings.py) ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Прочее ---
AUDIT_LOG_RETENTION_DAYS=180

# --- Только локальная разработка (не задавайте на production) ---
# Пароль для setup_dev_data.py / load_test_data.py / create_full_test_data.py
DEV_TEST_PASSWORD=test123

# --- Frontend (Vite dev; читается из корневого .env) ---
# Обычно /api — прокси на Django :8000
VITE_API_BASE=/api
