# Copy to .env and adjust.
# For production: set your domain, use https in CORS/CSRF origins, and set DJANGO_DEBUG=False.

POSTGRES_PASSWORD=vuvoz_secret
DJANGO_SECRET_KEY=your-secret-key

# Production: must be False
DJANGO_DEBUG=False

# Comma-separated, no spaces. Production: your domain(s). For testing by IP: add server IP.
# Example (Ubuntu server): ALLOWED_HOSTS=85.239.40.127,localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated. Use http:// for IP testing, https:// for production domain.
# Example (testing at http://85.239.40.127): CORS_ALLOWED_ORIGINS=http://85.239.40.127
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Optional: base URL for API/media (e.g. https://vuvoz.example.com). Leave empty when same origin.
# BASE_URL=https://vuvoz.example.com

# Optional: set to false if SSL is not used (e.g. local Docker without HTTPS)
# SECURE_SSL_REDIRECT=True
