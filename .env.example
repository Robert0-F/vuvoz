# Copy to .env and adjust.
# For production: set your domain, use https in CORS/CSRF origins, and set DJANGO_DEBUG=False.

POSTGRES_PASSWORD=vuvoz_secret
DJANGO_SECRET_KEY=your-secret-key

# Production: must be False
DJANGO_DEBUG=False

# Comma-separated. Production: your domain(s), e.g. vuvoz.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Production: use https://your-domain.com (comma-separated if multiple)
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Optional: base URL for API/media (e.g. https://vuvoz.example.com). Leave empty when same origin.
# BASE_URL=https://vuvoz.example.com

# Optional: set to false if SSL is not used (e.g. local Docker without HTTPS)
# SECURE_SSL_REDIRECT=True
